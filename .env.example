# 复制这个文件为 .env.local（本地开发）或在 Vercel/Docker 里配置同名环境变量，
# 真实的 key 永远不要提交进 git（.env.local 已经在 .gitignore 里）。

# --- Supabase（数据库 + 鉴权 + 存储） ---
# 去 supabase.com 建一个项目，在 Project Settings → API 里能找到这两个值
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 服务端专用（有更高权限，绝对不能加 NEXT_PUBLIC_ 前缀，不能暴露给浏览器）
# 本地导入脚本 npm run import:data 会用它写库（只读数据不需要它）
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM Providers（见 CLAUDE.md "多LLM支持"，不需要每个都填，缺的provider前端选它时会报错但不影响其他provider） ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Gemini：demo 默认兜底文本模型（分类/抽取拿不准时的文本 LLM 兜底走它）。
# 本地没有它也能跑通样例：分类/抽取是"规则优先"，比对是精确比，规则路径不依赖任何 key。
GOOGLE_GENERATIVE_AI_API_KEY=

# TypeSafe Jev（结构化决策模型，用于分类/比对，不做文本抽取，见 lib/llm/jev.ts）
# 去 https://console.typesafe.ai 拿 key；选填 JEV_MODEL，默认 jev-latest
TYPESAFE_API_KEY=
JEV_MODEL=

# 本地 LM Studio（只在本地/Docker部署时生效，Vercel云端用不了，见 lib/llm）
# LM Studio 打开后默认会在这个地址起一个 OpenAI 兼容的本地服务
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# --- 第二阶段：配置中心（见 PHASE2_SPEC.md） ---
# 敏感配置（API key、OAuth token）的加密主密钥：32 字节 base64
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 安全底线：这把密钥只放环境变量，永不入库/入 git；丢失 = 已加密的配置无法解密
ENCRYPTION_MASTER_KEY=
# 配置写入 / 文件上传等写操作的管理口令（请求头 x-admin-token）
# 不配置时所有写操作被拒绝；读取接口不受影响（裁判/访客可自由查看）
ADMIN_TOKEN=
