%% Block grid approach: `columns` locks in 3 columns for a natural 1:1 ratio, without relying on the `direction` directive (the renderer ignores it).
block-beta
  columns 3
  UI["Web UI"] REST["REST API"] MCP["MCP · 28 tools"]
  CLS["classification"] EXT["extraction"] CMP["comparison"]
  PIPE["pipeline"] RES["results"] REV["review loop"]
  SB["sandbox"] CFG["config·mail·import"] space
  LIB["lib/ shared area: LLM adapters · fingerprint cache · bounded concurrency · encrypted write protection"]:3
  DB[("Supabase")]:3
  UI --> CLS
  REST --> EXT
  MCP --> CMP
  CLS --> PIPE
  EXT --> RES
  CMP --> REV
  PIPE --> LIB
  RES --> LIB
  REV --> LIB
  SB --> LIB
  CFG --> LIB
  LIB --> DB
