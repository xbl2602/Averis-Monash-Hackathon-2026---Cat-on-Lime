  columns 2
  IN["Secrets<br/>LLM keys etc."] K["Master key<br/>env var only"]
  E["Server-side encrypt<br/>AES-256-GCM"] DB["app_config table<br/>ciphertext only"]
  D["Decrypt server-side on use<br/>read APIs return masks only"]:2
  IN --> E
  K --> E
  E --> DB
  DB --> D
